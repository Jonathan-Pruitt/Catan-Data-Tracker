<Page x:Class="CatanCompanion.PageSetup"
      x:Name="Setup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CatanCompanion"
      xmlns:partials="clr-namespace:CatanCompanion.pages.views.partials"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageSetup">

    <StackPanel Orientation="Vertical" Style="{StaticResource Container}">
        <TextBlock Text="Welcome to Catan Companion!" Style="{StaticResource Header}" Padding="5,5,5,0"/>
        <TextBlock Text="A Settlers of Catan data tracking application" Style="{StaticResource Info}" Padding="5,0,5,5"/>
        <Separator Background="Black" Margin="0, 0, 0, 8"/>
        <StackPanel Orientation="Horizontal" Style="{StaticResource Y-Buffer}">
            <Label Content="Which version of Catan are you playing?"/>
            <ComboBox Name="cbGameVersion" MinWidth="75" SelectedIndex="0">
                <ComboBoxItem>Classic</ComboBoxItem>
                <ComboBoxItem>Seafarers</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <!-- COLLECT PLAYER NAMES AND TURN ORDER -->
        <partials:InputAndList 
            UCKey="players"
            ListSubmitted="InputAndList_DataSubmitted" 
            Request="Type the name of each player. The order of names should reflect the turn order" 
            Info="Press &lt;ENTER> to confirm. &lt;CLICK> to delete"
            BoxMinWidth="64"/>
        <Separator />
        <!-- COLLECT ALL RESOURCE HEX/TOKEN PAIRS -->
        <TextBlock Style="{StaticResource LText}">Please list the token values for each resource hex</TextBlock>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <partials:InputAndList 
                UCKey="wheat" 
                ListSubmitted="InputAndList_DataSubmitted" 
                Request="Wheat" 
                BoxMinWidth="36"
                Grid.Row="0"
                Grid.Column="0"/>
            <partials:InputAndList 
                UCKey="wood" 
                ListSubmitted="InputAndList_DataSubmitted" 
                Request="Wood"  
                BoxMinWidth="36"
                Grid.Row="1"
                Grid.Column="0"/>
            <partials:InputAndList 
                UCKey="brick" 
                ListSubmitted="InputAndList_DataSubmitted" 
                Request="Brick"
                BoxMinWidth="36"
                Grid.Row="2"
                Grid.Column="0"/>
            <partials:InputAndList 
                UCKey="sheep" 
                ListSubmitted="InputAndList_DataSubmitted" 
                Request="Sheep" 
                BoxMinWidth="36"
                Grid.Row="0"
                Grid.Column="1"/>
            <partials:InputAndList 
                UCKey="ore" 
                ListSubmitted="InputAndList_DataSubmitted" 
                Request="Ore" 
                BoxMinWidth="36"
                Grid.Row="1"
                Grid.Column="1"/>
            <partials:InputAndList 
                x:Name="inlistGold"
                UCKey="gold" 
                ListSubmitted="InputAndList_DataSubmitted" 
                Request="Gold" 
                BoxMinWidth="36"
                Grid.Row="2"
                Grid.Column="1"
                Visibility="Collapsed"/>
        </Grid>
    </StackPanel>
</Page>
