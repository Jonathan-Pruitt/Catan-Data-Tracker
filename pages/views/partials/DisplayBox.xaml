<UserControl x:Class="CatanCompanion.DisplayBox"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CatanCompanion"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border MinWidth="{Binding Path=MinWidth, ElementName=Root}" BorderBrush="Black" BorderThickness="1" Margin="4, 4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        
            <Label Grid.Column="0" Content="{Binding ElementName=Root, Path=DisplayValue}" HorizontalAlignment="Center" Style="{StaticResource LText}"></Label>
            <Button Grid.Column="1" VerticalAlignment="Top" Click="Button_Click">x</Button>
        </Grid>
    </Border>
</UserControl>
