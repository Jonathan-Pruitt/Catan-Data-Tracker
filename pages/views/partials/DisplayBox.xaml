<UserControl x:Class="CatanCompanion.DisplayBox"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CatanCompanion"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border MinWidth="{Binding Path=MinWidth, ElementName=Root}" BorderBrush="Black" BorderThickness="1" Margin="4, 4">
        <Button Content="{Binding ElementName=Root, Path=DisplayValue}" Grid.Column="1" VerticalAlignment="Top" Click="Button_Click" />
    </Border>
</UserControl>
