<UserControl x:Class="CatanCompanion.pages.views.partials.InputAndList"
             x:Name="RootInputAndList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CatanCompanion.pages.views.partials"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
            <Label Content="{Binding Path=Request, ElementName=RootInputAndList}" />
            <TextBlock Text="{Binding Path=Info, ElementName=RootInputAndList}" Style="{StaticResource Info}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBox Name="txtbxInputs" MinWidth="150" HorizontalAlignment="Left" KeyUp="txtbxInputs_KeyUp"/>
            <Button Click="Button_Click">OK</Button>
        </StackPanel>
        <StackPanel Name="stkpnlList" Orientation="Horizontal" MinHeight="25">
            <!-- LIST ITEMS POPULATE HERE -->
        </StackPanel>
    </StackPanel>
</UserControl>
